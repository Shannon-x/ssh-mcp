# ssh-mcp 配置模板：约 30 台主机，按角色分组。
#
# 这是给控制机用的 ssh-mcp 配置（例如 /etc/ssh-mcp/config.toml，属主是运行 ssh-mcp 的账号，
# 权限 600，否则 ssh-mcp 拒绝加载）。主机名、密钥路径都是占位符，换成你自己的；
# 真实地址和指纹只放在控制机上，不要提交回仓库。
#
# 分组思路：
#   生产（prod-*）：role = "viewer"、group = "prod"、readOnly = true、approvalPolicy = "deny"。
#     只能跑只读命令；任何改动、sudo 都直接拒绝，不弹审批。机器上也不装 sudoers，两层都锁死。
#   测试（test-*）：role = "tester"、group = "test"（下面 [policy] 里自定义）、approvalPolicy = "ask-destructive"。
#     只有通过参数语法检查的只读命令直接跑；未识别命令、删改和 sudo 每条都要你在 Claude 里点同意，
#     Claude 无法提供审批时拒绝执行，不能改成 auto 来绕过。
#     safe 是兼容旧配置的分类名，不是“无副作用”的保证；也必须审批。
#     sudo 还要命中机器上 /etc/sudoers.d/claudeops 的白名单才真的能执行。
#   审批永远不设 auto，approvalGrantTtlMs = 0：同意一次只管一条命令。
#
# 主机指纹：建议 ssh-mcp 用 --hostKeyMode=strict 启动，这样没钉指纹的主机一律拒连。
# bootstrap-hosts.sh 会在每台机器上读出 ed25519 指纹，按 profile 名字打印出
# trustedHostKey = "SHA256:..." 这一行，复制到对应 profile 里即可。
# 这里不预填假指纹：假指纹谁都匹配不上，只会让每台机器报指纹不符。
#
# 改完后 `kill -HUP <ssh-mcp 进程>` 或 `systemctl reload ssh-mcp` 热加载；
# 配置写错时热加载会被拒绝，旧配置继续生效。

[defaults]
# 没指定主机时不默认连任何一台，避免模型漏写 profile 时落到生产上。
# （不写 defaultProfile 就没有默认主机。）
sessionMaxPerConnection = 3
sessionIdleTimeoutMs = 300000       # 交互会话闲置 5 分钟关闭
sessionBackgroundMaxMs = 1800000    # 后台会话最长 30 分钟
commandTimeoutMs = 60000
commandMaxChars = 2000
commandMaxOutputBytes = 262144      # 单条命令输出最多 256KB，少喂给模型一些不可信文本
connectionIdleReapMs = 600000
commandQuotaPerDay = 300            # 每台机器 24 小时滑动窗口内最多 300 条，防止模型被带偏后刷命令
approvalMode = "ask-destructive"    # 兜底值；下面每个 profile 都显式写了自己的 approvalPolicy
approvalGrantTtlMs = 0              # 0 = 每条需要审批的命令都单独问，不做“同意后一段时间内免问”
# 文件上传下载默认关闭：不设 transferRoot，sftp-upload-file / sftp-download-file 就拒绝执行。
# transferRoot = "/srv/ssh-mcp-transfers"

# ======================================================================
# 生产 Web 前端
# ======================================================================
[[profiles]]
name = "prod-web-01"
host = "prod-web-01.example.internal"   # 占位符，换成控制机能解析的地址
user = "claudeops"
auth = "key"
keyRef = "/home/sshmcp/.ssh/claudeops_ed25519"
group = "prod"
role = "viewer"
readOnly = true
approvalPolicy = "deny"
# trustedHostKey = "SHA256:..."   # 用 bootstrap-hosts.sh 打印的那一行替换

