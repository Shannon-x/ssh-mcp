# ======================================================================
# 策略：自定义测试层级，并追加禁用命令
# ======================================================================

[policy]
# 正则，区分大小写，匹配整条命令。和内置的“永不允许”列表叠加，不会替换它
# （内置的已经挡了 rm -rf /、mkfs、dd 写盘、shutdown、curl|sh、改 cron/systemd/authorized_keys 等）。
# 写错的正则会让 ssh-mcp 启动失败，而不是被悄悄忽略。
denylist = [
  # 改账号、改口令、改 sudo：这些只能你自己来
  "\\b(useradd|userdel|usermod|groupadd|groupdel|gpasswd|passwd|chpasswd|chage|visudo|sudoedit)\\b",
  # 常驻和自启动：crontab、systemd 单元的自启和改动
  "\\bcrontab\\b",
  "\\bsystemctl\\s+(enable|disable|mask|unmask|daemon-reload|edit|link|set-default|isolate)\\b",
  # 主机防火墙和 sshd 本身
  "\\b(iptables|ip6tables|nft|ufw|firewall-cmd)\\b",
  "/etc/ssh/",                       # 连读也拦：sshd 配置不需要模型来看
  # 反弹 shell 和把数据往外送：命令输出里可能夹着诱导模型外传数据的文字
  "\\b(nc|ncat|netcat|socat|telnet)\\b",
  "\\bcurl\\b.*\\s(-T|--upload-file|-F|--form|-d|--data[a-z-]*)\\b",
  "\\bwget\\b.*--post-(data|file)",
  # 不写成 \\bsftp\\b：ssh-mcp 自己的 sftp-list 等工具的命令串以 "sftp:" 开头，会被误拦
  "\\b(scp|rsync)\\b",
  "(^|[\\s;&|(])sftp\\s",
  # 抹痕迹和不可逆的擦除
  "\\bhistory\\s+-c\\b",
  "\\b(shred|wipefs|chattr)\\b",
  # 编排和基础设施工具：一条命令影响面太大
  "\\b(terraform|pulumi)\\s+(apply|destroy|import)\\b",
  "\\bkubectl\\s+(delete|drain|cordon|scale|apply|replace|patch)\\b",
  "\\bdocker\\s+(rm|rmi|system\\s+prune|volume\\s+(rm|prune)|network\\s+rm)\\b",
  "\\bgit\\s+push\\b.*(-f|--force)",
]

# 测试机专用的角色和层级。生产用内置的 viewer + prod（只读），这里不碰。
# privileged（sudo）在这里放开，但：
#   - approvalPolicy = "ask-destructive" 让每条未被证明只读的操作（含 sudo）都要你点同意；
#   - 机器上 sudoers 只允许白名单里的几条命令。
[policy.roleBindings.tester]
test = ["read-only", "safe", "destructive", "privileged"]
