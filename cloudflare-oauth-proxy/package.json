{
  "name": "ssh-mcp-oauth-proxy",
  "private": true,
  "version": "0.1.0",
  "description": "OAuth 2.1 front proxy (Cloudflare Worker) that lets claude.ai connect to ssh-mcp's HTTP mode, signed in with GitHub and limited to one owner.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "5.9.2",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  }
}
